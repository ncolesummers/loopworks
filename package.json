{
  "name": "loopworks",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:fixture": "LOOPWORKS_AUTH_BYPASS=true next dev -H 127.0.0.1",
    "build": "bun run build:eve && bun run build:next",
    "build:eve": "bunx eve build",
    "build:next": "next build",
    "vercel-build": "bun run db:migrate && bun run build:next",
    "start": "next start -H 127.0.0.1",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "agent-docs:sync": "bun run scripts/sync-agent-docs.ts --write",
    "agent-docs:check": "bun run scripts/sync-agent-docs.ts --check",
    "config:sync": "bun run scripts/sync-env-example.ts --write",
    "config:check": "bun run scripts/sync-env-example.ts --check",
    "config:access-check": "bun run scripts/check-env-access.ts",
    "vercel-env:check": "bun run scripts/sync-vercel-env.ts --check",
    "vercel-env:write": "bun run scripts/sync-vercel-env.ts --write",
    "commit:preflight": "bun run scripts/check-commit-provenance.ts --local",
    "commit:provenance": "bun run scripts/check-commit-provenance.ts",
    "markdownlint": "markdownlint-cli2",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:validation-evidence": "playwright test --config=playwright.validation-evidence.config.ts",
    "test:e2e:seeded": "bun run scripts/test-seeded-postgres.ts",
    "test:integration:postgres": "bun run scripts/test-native-postgres.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "review:ui": "bun run scripts/review-ui.mjs",
    "precommit": "bun run commit:preflight && bun run validate",
    "precommit:install": "uvx prek install",
    "precommit:run": "uvx prek run --all-files",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate-database.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed-demo-data.ts",
    "db:seed:reset": "bun run scripts/seed-demo-data.ts --reset",
    "github:webhook-fixture": "bun run scripts/github-webhook-fixture.ts",
    "security:osv": "bun run scripts/run-security-scanner.ts osv",
    "security:gitleaks": "bun run scripts/run-security-scanner.ts gitleaks",
    "security:gitleaks:history": "bun run scripts/run-security-scanner.ts gitleaks-history",
    "security:semgrep": "bun run scripts/run-security-scanner.ts semgrep",
    "security:scan": "bun run security:osv && bun run security:gitleaks && bun run security:semgrep",
    "validate": "bun run check && bun run agent-docs:check && bun run config:check && bun run config:access-check && bun run security:osv && bun run security:gitleaks && bun run security:semgrep && bun run markdownlint && bun run typecheck && bun run test && bun run storybook:build && bun run test:e2e"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.57.2",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@vercel/otel": "^1.14.2",
    "@vercel/sdk": "^1.28.16",
    "ai": "7.0.58",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.0",
    "eve": "0.33.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postgres": "^3.4.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.7",
    "@electric-sql/pglite": "^0.5.4",
    "@opentelemetry/context-async-hooks": "^1.30.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/nextjs-vite": "^10.5.7",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "just-bash": "^3.2.0",
    "markdownlint-cli2": "^0.23.2",
    "msw": "^2.15.0",
    "playwright-core": "1.62.1",
    "postcss": "^8.5.26",
    "smol-toml": "^1.7.1",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "fast-xml-parser": "5.10.1",
    "nanoid": "3.3.17",
    "postcss": "8.5.26",
    "protobufjs": "7.6.5"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "image-size@2.0.2": "patches/image-size@2.0.2.patch",
    "typescript@6.0.3": "patches/typescript@6.0.3.patch"
  }
}
