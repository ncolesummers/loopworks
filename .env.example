# Generated from src/lib/config/registry.ts.
# Run `bun run config:sync` after changing configuration declarations.
# Auth.js session secret; generate with `npx auth secret` or OpenSSL.
AUTH_SECRET="replace-with-auth-secret"
# GitHub OAuth application client ID used for SSO sign-in.
AUTH_GITHUB_ID="replace-with-github-oauth-client-id"
# GitHub OAuth application client secret used for SSO sign-in.
AUTH_GITHUB_SECRET="replace-with-github-oauth-client-secret"
# Skip GitHub SSO authorization in non-production development only.
LOOPWORKS_AUTH_BYPASS="false"
# Comma-separated GitHub user login allowlist.
LOOPWORKS_ALLOWED_GITHUB_USERS="ncolesummers"
# Comma-separated GitHub organization allowlist.
LOOPWORKS_ALLOWED_GITHUB_ORGS=""

# Pooled Postgres connection URL used by application queries.
DATABASE_URL="postgres://loopworks:loopworks@127.0.0.1:5432/loopworks"
# Direct Postgres connection URL used by deployment migrations.
DATABASE_URL_UNPOOLED="postgres://loopworks:loopworks@127.0.0.1:5432/loopworks"

# Canonical portal origin used for durable run backlinks.
LOOPWORKS_PUBLIC_URL="http://127.0.0.1:3000"

# Fallback kill switch for webhook-triggered loops.
LOOPWORKS_AGENT_READY_LOOP_ENABLED="true"
# Kill switch for development-loop webhook starts.
LOOPWORKS_DEVELOPMENT_LOOP_ENABLED="true"
# Kill switch for research-loop webhook starts.
LOOPWORKS_RESEARCH_LOOP_ENABLED="true"

# Serve canned portal data in non-production when set to fixtures.
LOOPWORKS_PORTAL_DATA_MODE=""

# HMAC secret used to sign stage execution receipts.
LOOPWORKS_EVE_TEST_RECEIPT_SECRET="replace-with-test-receipt-secret"
# Replay the planning-agent fixture in non-production.
LOOPWORKS_EVE_FIXTURE_MODE="false"
# Replay the test-writer fixture in non-production.
LOOPWORKS_EVE_TEST_WRITER_FIXTURE_MODE="false"
# Replay the implementation fixture in non-production.
LOOPWORKS_EVE_IMPLEMENTER_FIXTURE_MODE="false"
# Replay the validation-review fixture in non-production.
LOOPWORKS_EVE_VALIDATION_REVIEWER_FIXTURE_MODE="false"
# Replay the PR-preparation fixture in non-production.
LOOPWORKS_EVE_PR_PREPARER_FIXTURE_MODE="false"
# Allow raw agent I/O capture in non-production.
LOOPWORKS_EVE_CAPTURE_IO="false"

# Pino log level.
LOG_LEVEL="info"
# OTLP exporter protocol.
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
# Metrics-specific OTLP exporter protocol.
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL="http/protobuf"
# Shared OTLP exporter endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=""
# Trace-specific OTLP endpoint.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=""
# Metrics-specific OTLP endpoint.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=""
# Logs-specific OTLP endpoint.
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=""
# Shared OTLP exporter authentication headers.
OTEL_EXPORTER_OTLP_HEADERS=""
# Trace exporter authentication headers.
OTEL_EXPORTER_OTLP_TRACES_HEADERS=""
# Metrics exporter authentication headers.
OTEL_EXPORTER_OTLP_METRICS_HEADERS=""
# OTel service name override.
OTEL_SERVICE_NAME="loopworks"
# Additional OTel resource key-value pairs.
OTEL_RESOURCE_ATTRIBUTES=""

# GitHub App identifier used for issue and pull-request automation.
GITHUB_APP_ID=""
# GitHub App PEM private key; escaped newlines are accepted.
GITHUB_APP_PRIVATE_KEY=""
# Secret used to verify and generate GitHub webhook signatures.
GITHUB_WEBHOOK_SECRET="dev-webhook-secret"

# Vercel API access token used for deployment visibility.
VERCEL_ACCESS_TOKEN=""
# Optional Vercel team identifier.
VERCEL_TEAM_ID=""
# Optional Vercel team slug.
VERCEL_TEAM_SLUG=""
