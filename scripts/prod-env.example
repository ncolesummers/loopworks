# Fill in, save as prod-env.local, then: ./set-production-env.sh prod-env.local
# Do not commit this file.

# --- From the GitHub App you create (Settings -> Developer settings -> GitHub Apps)
GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_SLUG=""
# Paste the whole PEM. Literal \n escapes are accepted, so this works:
#   GITHUB_APP_PRIVATE_KEY="$(awk 'BEGIN{ORS="\\n"}1' ~/Downloads/your-app.private-key.pem)"
GITHUB_APP_PRIVATE_KEY=""

# --- Sign-in. The same GitHub App client credentials serve both, which is why
# --- the App carries two callback URLs.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Runtime
LOOPWORKS_PUBLIC_URL="https://loopworks.vercel.app"
LOOPWORKS_ALLOWED_GITHUB_USERS="ncolesummers"

# --- Secrets: generate with `openssl rand -hex 32`
LOOPWORKS_EVE_TEST_RECEIPT_SECRET=""
GITHUB_WEBHOOK_SECRET=""
